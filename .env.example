DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_app"
# En Neon, usa DATABASE_URL con pooler para runtime y DATABASE_URL_UNPOOLED sin pooler para migraciones.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/edu_app"

BETTER_AUTH_SECRET="cambia-esto-por-una-clave-segura-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="EduNivel <onboarding@resend.dev>"

# Numero de soporte de WhatsApp: codigo de pais + numero, sin +, espacios ni guiones.
CONTACT_WHATSAPP_NUMBER="50670196686"

# ONVO Sandbox. Nunca uses prefijo NEXT_PUBLIC_ para estas variables.
ONVO_ENV="test"
ONVO_SECRET_KEY="onvo_test_secret_key_reemplaza_con_tu_llave"
# Debe permanecer false. Live exige ademas VERCEL_ENV=production.
ONVO_LIVE_ENABLED="false"

# Se obtiene al crear el webhook en el Dashboard de ONVO.
ONVO_WEBHOOK_SECRET="webhook_secret_reemplaza_despues_de_crear_el_webhook"

# Numero oficial por defecto. Reemplazalo si ONVO asigna uno personalizado al comercio.
ONVO_SINPE_DESTINATION_NUMBER="+50670196686"

# Vercel lo envia como Authorization: Bearer al ejecutar la conciliacion programada.
# Usa una cadena aleatoria de al menos 16 caracteres. Sin ella, ONVO queda deshabilitado.
CRON_SECRET="reemplaza-con-un-secreto-aleatorio"

# Cloudflare R2. Usa un bucket distinto en desarrollo y produccion.
# En Vercel Preview configura R2_UPLOADS_ENABLED=false.
R2_UPLOADS_ENABLED="false"
R2_ACCOUNT_ID="reemplaza-con-el-account-id"
R2_ACCESS_KEY_ID="reemplaza-con-el-access-key-id"
R2_SECRET_ACCESS_KEY="reemplaza-con-el-secret-access-key"
R2_BUCKET_NAME="edunivel-development"
