// ============================================================
// Generator & Datasource
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  STUDENT
  TEACHER
  COLLABORATOR
  ADMIN
}

enum NotificationType {
  GENERAL_ALERT
  IMPORTANT_NOTICE
  SUBSCRIPTION_RENEWAL
}

enum NotificationAudienceMode {
  SELECTED_USERS
  ALL_USERS
  ROLES
  SUBSCRIPTIONS
}

enum PlanCode {
  STUDENT_MONTHLY
  STUDENT_YEARLY
  TEACHER_MONTHLY
  TEACHER_YEARLY
}

enum SubscriptionProduct {
  STUDENT_PREMIUM
  TEACHER_PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  INITIALIZING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  REQUIRES_REVIEW
}

enum RefundStatus {
  // Legacy compatibility only. EduNivel no longer creates or processes refunds.
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  REQUIRES_REVIEW
  CANCELED
}

enum PaymentProvider {
  ONVO
}

enum PaymentMethod {
  SINPE_MOBILE
}

enum ProviderMode {
  TEST
  LIVE
}

enum WebhookOutcome {
  PROCESSED
  IGNORED
  REQUIRES_REVIEW
  FAILED
  PROCESSING
}

enum ResourceType {
  NOTE
  QUIZ
  YOUTUBE
  PDF
  FILE
  LINK
  GAME
  IMAGE
  AUDIO
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ContentAudience {
  STUDENT
  TEACHER
  BOTH
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  UNPUBLISHED
}

enum ContentRevisionKind {
  MODULE
  RESOURCE
}

enum ContentRevisionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
}

enum UploadStatus {
  PENDING
  PROCESSING
  CONFIRMED
  CLEANUP_PENDING
  FAILED
  EXPIRED
}

// ============================================================
// Better Auth — User / Session / Account / Verification
// (No modificar campos existentes: Better Auth los gestiona)
// ============================================================

model User {
  id                     String    @id
  name                   String
  email                  String    @unique
  emailVerified          Boolean   @default(false)
  emailVerifiedAt        DateTime?
  image                  String?
  birthDate              DateTime?
  ageDeclared            Int?
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  ageVerifiedAt          DateTime?
  role                   Role      @default(STUDENT)
  suspendedAt            DateTime?
  suspensionReason       String?
  suspensionExpiresAt    DateTime?
  adminCreatedAt         DateTime?
  invitationPending      Boolean   @default(false)
  passwordChangeRequired Boolean   @default(false)
  deletedAt              DateTime?
  selectedLevelId        String?
  selectedLevel          Level?    @relation("SelectedLevel", fields: [selectedLevelId], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  subscriptions        Subscription[]
  payments             Payment[]
  refundsRequested     PaymentRefund[]    @relation("RefundRequester")
  progress             ResourceProgress[]
  learnerActivityDays  LearnerActivityDay[]
  savedResources       SavedResource[]
  createdModules       Module[]           @relation("ModuleCreator")
  updatedModules       Module[]           @relation("ModuleUpdater")
  submittedModules     Module[]           @relation("ModuleSubmitter")
  reviewedModules      Module[]           @relation("ModuleReviewer")
  publishedModules     Module[]           @relation("ModulePublisher")
  createdResources     Resource[]         @relation("ResourceCreator")
  updatedResources     Resource[]         @relation("ResourceUpdater")
  submittedResources   Resource[]         @relation("ResourceSubmitter")
  reviewedResources    Resource[]         @relation("ResourceReviewer")
  publishedResources   Resource[]         @relation("ResourcePublisher")
  uploadIntents        UploadIntent[]
  contentImages        ContentImage[]      @relation("ContentImageCreator")
  invitationsSent      UserInvitation[]   @relation("InvitationSender")
  acceptedInvitation   UserInvitation?    @relation("InvitationAcceptedUser")
  adminActionsTaken    AdminAuditLog[]    @relation("AuditActor")
  adminActionsTargeted AdminAuditLog[]    @relation("AuditTarget")
  notificationsSent    Notification[]    @relation("NotificationSender")
  notificationsReceived NotificationRecipient[]
  quizAttempts           QuizAttempt[]
  contentRevisionsCreated   ContentRevision[]       @relation("ContentRevisionCreator")
  contentRevisionsUpdated   ContentRevision[]       @relation("ContentRevisionUpdater")
  contentRevisionsSubmitted ContentRevision[]       @relation("ContentRevisionSubmitter")
  contentRevisionsReviewed  ContentRevision[]       @relation("ContentRevisionReviewer")
  contentAuditEvents        ContentAuditLog[]       @relation("ContentAuditActor")

  @@index([deletedAt])
  @@index([emailVerifiedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model OtpRateLimitEvent {
  id        String   @id @default(cuid())
  operation String
  category  String
  emailHash String?
  ipHash    String
  createdAt DateTime @default(now())

  @@index([operation, emailHash, createdAt])
  @@index([category, ipHash, createdAt])
  @@index([createdAt])
  @@map("otp_rate_limit_event")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  action       String
  reason       String?
  changes      Json?
  createdAt    DateTime @default(now())

  actor      User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

model UserInvitation {
  id              String    @id @default(cuid())
  email           String
  activeEmail     String?   @unique
  name            String
  role            Role
  tokenHash       String    @unique
  selectedLevelId String?
  selectedLevel   Level?    @relation(fields: [selectedLevelId], references: [id], onDelete: SetNull)
  invitedById     String
  invitedBy       User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUserId  String?   @unique
  acceptedUser    User?     @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  acceptedAt      DateTime?
  canceledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([selectedLevelId])
  @@map("user_invitation")
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  levelId            String
  product            SubscriptionProduct
  status             SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  lastPlanCode       PlanCode?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level    Level     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  payments Payment[]
  notificationRecipients NotificationRecipient[]

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscription")
}

model Notification {
  id                  String                   @id @default(cuid())
  type                NotificationType
  title               String                   @db.VarChar(150)
  body                String                   @db.VarChar(5000)
  sentById            String
  sentAt              DateTime                 @default(now())
  audienceMode        NotificationAudienceMode
  audienceRoles       Role[]                   @default([])
  requestId           String                   @unique @db.Uuid
  payloadHash         String                   @db.Char(64)
  resendOfRecipientId String?                  @unique

  sentBy              User                     @relation("NotificationSender", fields: [sentById], references: [id], onDelete: Restrict)
  recipients          NotificationRecipient[]   @relation("NotificationDeliveries")
  resendOfRecipient   NotificationRecipient?    @relation("NotificationResend", fields: [resendOfRecipientId], references: [id], onDelete: Restrict)

  @@index([sentAt, id])
  @@index([sentById, sentAt])
  @@index([type, sentAt])
  @@map("notification")
}

model NotificationRecipient {
  id                  String        @id @default(cuid())
  notificationId      String
  userId              String
  targetKey           String
  receivedAt          DateTime       @default(now())
  readAt              DateTime?
  subscriptionId      String?
  periodEndSnapshot   DateTime?
  levelNumberSnapshot Int?
  initialReminderKey  String?       @unique

  notification        Notification  @relation("NotificationDeliveries", fields: [notificationId], references: [id], onDelete: Restrict)
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  resend              Notification? @relation("NotificationResend")

  @@unique([notificationId, targetKey])
  @@index([userId, receivedAt, id])
  @@index([userId, readAt, receivedAt, id])
  @@index([subscriptionId, periodEndSnapshot])
  @@map("notification_recipient")
}

model Payment {
  id                       String              @id @default(cuid())
  userId                   String
  levelId                  String?
  levelNumberSnapshot      Int?
  subscriptionId           String?
  planCode                 PlanCode
  product                  SubscriptionProduct
  billingInterval          BillingInterval
  durationMonths           Int
  roleAtCheckout           Role
  expectedAmountMinor      Int
  receivedAmountMinor      Int?
  currency                 String              @default("CRC") @db.VarChar(3)
  provider                 PaymentProvider     @default(ONVO)
  method                   PaymentMethod       @default(SINPE_MOBILE)
  providerMode             ProviderMode
  providerStatus           String?
  providerPaymentIntentId  String?             @unique
  providerPaymentMethodId  String?
  providerChargeId         String?
  internalReference        String              @unique
  checkoutRequestId        String              @unique
  status                   PaymentStatus       @default(INITIALIZING)
  confirmedAt              DateTime?
  appliedAt                DateTime?
  staleAt                  DateTime?
  payerPhoneLast4          String?
  payerIdentificationLast4 String?
  payerIdentificationType  Int?
  errorCode                String?
  errorMessage             String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  level        Level?          @relation(fields: [levelId], references: [id], onDelete: SetNull)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  refunds      PaymentRefund[]

  @@index([userId, status])
  @@index([levelId])
  @@index([subscriptionId])
  @@index([providerStatus])
  @@index([createdAt])
  @@index([providerMode, status, appliedAt])
  @@index([providerMode, createdAt, id])
  @@map("payment")
}

/// Legacy compatibility model. Existing rows are retained for audit/read-only
/// purposes; no active application flow may create or reconcile these records.
model PaymentRefund {
  id                  String          @id @default(cuid())
  paymentId           String
  provider            PaymentProvider @default(ONVO)
  providerMode        ProviderMode
  providerRefundId    String?         @unique
  expectedAmountMinor Int
  providerAmountMinor Int?
  currency            String          @db.VarChar(3)
  status              RefundStatus    @default(REQUESTED)
  providerStatus      String?
  reason              String?
  requestedById       String?
  requestedAt         DateTime        @default(now())
  providerCreatedAt   DateTime?
  providerUpdatedAt   DateTime?
  lastCheckedAt       DateTime?
  appliedAt           DateTime?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@index([status, updatedAt])
  @@index([requestedById, requestedAt])
  @@map("payment_refund")
}

model WebhookReceipt {
  id                  String          @id @default(cuid())
  provider            PaymentProvider @default(ONVO)
  eventType           String
  providerObjectId    String?
  payloadHash         String?
  deduplicationKey    String?         @unique
  outcome             WebhookOutcome
  receivedAt          DateTime        @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  errorCode           String?

  @@index([provider, providerObjectId])
  @@index([payloadHash])
  @@index([receivedAt])
  @@map("webhook_receipt")
}

// ============================================================
// Dominio Educativo — Jerarquía: Nivel → Materia → Módulo → Recurso
// ============================================================

model Level {
  id                   String   @id @default(cuid())
  levelNumber          Int      @unique
  description          String?
  requiresSubscription Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subjects        Subject[]
  selectedUsers   User[]           @relation("SelectedLevel")
  subscriptions   Subscription[]
  payments        Payment[]
  userInvitations UserInvitation[]

  @@map("level")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]

  @@unique([levelId, name])
  @@index([levelId])
  @@map("subject")
}

model Module {
  id                   String            @id @default(cuid())
  title                String
  description          String?
  subjectId            String
  subject              Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  audience             ContentAudience   @default(BOTH)
  publicationStatus    PublicationStatus @default(DRAFT)
  createdById          String
  createdBy            User              @relation("ModuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById          String?
  updatedBy            User?             @relation("ModuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedForReviewAt DateTime?
  submittedById        String?
  submittedBy          User?             @relation("ModuleSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById         String?
  reviewedBy           User?             @relation("ModuleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  reviewNote           String?
  publishedById        String?
  publishedBy          User?             @relation("ModulePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  order                Int               @default(0)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  resources     Resource[]
  uploadIntents UploadIntent[]
  revisions     ContentRevision[] @relation("ModuleContentRevisions")

  @@unique([subjectId, title])
  @@index([subjectId])
  @@index([createdById])
  @@index([updatedById])
  @@index([submittedById])
  @@index([publicationStatus])
  @@index([audience])
  @@map("module")
}

model Resource {
  id                   String            @id @default(cuid())
  moduleId             String
  module               Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type                 ResourceType
  title                String
  instructions         String?
  content              String?           @db.Text
  estimatedMinutes     Int?
  publicationStatus    PublicationStatus @default(DRAFT)
  createdById          String
  createdBy            User              @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById          String?
  updatedBy            User?             @relation("ResourceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedForReviewAt DateTime?
  submittedById        String?
  submittedBy          User?             @relation("ResourceSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById         String?
  reviewedBy           User?             @relation("ResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  reviewNote           String?
  publishedById        String?
  publishedBy          User?             @relation("ResourcePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  uploadIntentId       String?           @unique
  uploadIntent         UploadIntent?     @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)
  order                Int               @default(0)
  isActive             Boolean           @default(true)
  isRequired           Boolean           @default(false)
  isFreePreview        Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  quiz          Quiz?
  youtubeVideo  YoutubeVideo?
  pdfResource   PdfResource?
  fileResource  FileResource?
  linkResource  LinkResource?
  gameResource  GameResource?
  imageResource ImageResource?
  audioResource AudioResource?
  contentImages ResourceContentImage[]
  revisions     ContentRevision[]      @relation("ResourceContentRevisions")

  progress ResourceProgress[]
  savedBy  SavedResource[]

  @@index([moduleId])
  @@index([type])
  @@index([createdById])
  @@index([updatedById])
  @@index([submittedById])
  @@index([publicationStatus])
  @@map("resource")
}

/// One active editorial revision may exist for a module or resource. Published
/// rows remain untouched until an administrator approves the revision.
model ContentRevision {
  id            String                @id @default(cuid())
  kind          ContentRevisionKind
  status        ContentRevisionStatus @default(DRAFT)
  moduleId      String?               @unique
  module        Module?               @relation("ModuleContentRevisions", fields: [moduleId], references: [id], onDelete: Cascade)
  resourceId    String?               @unique
  resource      Resource?             @relation("ResourceContentRevisions", fields: [resourceId], references: [id], onDelete: Cascade)
  payload       Json
  baseUpdatedAt DateTime
  createdById   String
  createdBy     User                  @relation("ContentRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String
  updatedBy     User                  @relation("ContentRevisionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedById String?
  submittedBy   User?                 @relation("ContentRevisionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?
  reviewedById  String?
  reviewedBy    User?                 @relation("ContentRevisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([kind, status, updatedAt])
  @@index([createdById, status])
  @@index([updatedById, updatedAt])
  @@map("content_revision")
}

model ContentAuditLog {
  id         String              @id @default(cuid())
  actorId    String
  actor      User                @relation("ContentAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  kind       ContentRevisionKind
  entityId   String
  action     String
  revisionId String?
  changes    Json?
  createdAt  DateTime            @default(now())

  @@index([entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("content_audit_log")
}

model UploadIntent {
  id                      String            @id @default(cuid())
  createdById             String
  createdBy               User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  moduleId                String
  module                  Module            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  reservedResourceId      String            @unique
  editorSessionId         String
  resourceType            ResourceType
  targetPublicationStatus PublicationStatus @default(DRAFT)
  title                   String
  instructions            String?
  content                 String?           @db.Text
  estimatedMinutes        Int?
  originalName            String
  altText                 String?
  temporaryStorageKey     String            @unique
  permanentStorageKey     String            @unique
  expectedMimeType        String
  expectedSizeBytes       BigInt
  temporaryObjectEtag     String?
  status                  UploadStatus      @default(PENDING)
  expiresAt               DateTime
  confirmedAt             DateTime?
  processingStartedAt     DateTime?
  cleanupLeaseUntil       DateTime?
  attemptCount            Int               @default(0)
  lastAttemptAt           DateTime?
  failureCode             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  resource Resource?

  @@index([createdById])
  @@index([moduleId])
  @@index([status, expiresAt])
  @@index([cleanupLeaseUntil])
  @@map("upload_intent")
}

model ContentImage {
  id                    String       @id
  createdById           String
  createdBy             User         @relation("ContentImageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  editorSessionId       String
  temporaryStorageKey   String       @unique
  storageKey            String       @unique
  originalName          String
  mimeType              String
  sizeBytes             BigInt
  temporaryObjectEtag   String?
  status                UploadStatus @default(PENDING)
  uploadExpiresAt       DateTime
  orphanExpiresAt       DateTime?
  confirmedAt           DateTime?
  processingStartedAt   DateTime?
  cleanupLeaseUntil     DateTime?
  attemptCount          Int          @default(0)
  lastAttemptAt         DateTime?
  failureCode           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  resources ResourceContentImage[]

  @@index([createdById, editorSessionId])
  @@index([status, uploadExpiresAt])
  @@index([orphanExpiresAt])
  @@index([cleanupLeaseUntil])
  @@map("content_image")
}

model StorageObjectCleanup {
  id            String   @id @default(cuid())
  storageKey    String   @unique
  attemptCount  Int      @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@map("storage_object_cleanup")
}

model ResourceContentImage {
  resourceId     String
  resource       Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  contentImageId String
  contentImage   ContentImage @relation(fields: [contentImageId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([resourceId, contentImageId])
  @@index([contentImageId])
  @@map("resource_content_image")
}

// ============================================================
// Tipos de Recursos Especializados
// Cada tabla apunta a Resource con FK única + onDelete: Cascade
// ============================================================

model Quiz {
  id               String   @id @default(cuid())
  resourceId       String   @unique
  resource         Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  passingScore     Int      @default(70)
  maxAttempts      Int?
  shuffleQuestions Boolean  @default(false)
  questions        Json
  attempts         QuizAttempt[]

  @@map("quiz")
}

model QuizAttempt {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId           String
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  status           QuizAttemptStatus @default(IN_PROGRESS)
  questionsSnapshot Json
  answers          Json?
  questionCount    Int
  correctAnswers   Int?
  percentage       Float?
  passed           Boolean?
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?

  @@index([userId, quizId, startedAt])
  @@index([quizId, status])
  @@map("quiz_attempt")
}

model YoutubeVideo {
  id         String   @id @default(cuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  videoId    String
  duration   Int?
  startAt    Int?     @default(0)
  endAt      Int?

  @@map("youtube_video")
}

model PdfResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt?
  pageCount    Int?

  @@index([storageKey])
  @@map("pdf_resource")
}

model FileResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt?

  @@index([storageKey])
  @@map("file_resource")
}

model LinkResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  url          String
  openInNewTab Boolean  @default(true)

  @@map("link_resource")
}

model GameResource {
  id         String   @id @default(cuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  gameType   String
  config     Json

  @@map("game_resource")
}

model ImageResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  altText      String?
  caption      String?

  @@index([storageKey])
  @@map("image_resource")
}

model AudioResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt?
  duration     Int?
  transcript   String?  @db.Text

  @@index([storageKey])
  @@map("audio_resource")
}

// ============================================================
// Progreso del Usuario
// ============================================================

model LearnerActivityDay {
  id           String   @id @default(cuid())
  userId       String
  activityDate DateTime @db.Date
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId, activityDate(sort: Desc)])
  @@map("learner_activity_day")
}

model ResourceProgress {
  id           String    @id @default(cuid())
  userId       String
  resourceId   String
  completed    Boolean   @default(false)
  score        Float?
  attempts     Int       @default(0)
  startedAt    DateTime  @default(now())
  lastViewedAt DateTime  @default(now())
  completedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([userId, lastViewedAt])
  @@index([resourceId])
  @@map("resource_progress")
}

model SavedResource {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, createdAt])
  @@index([resourceId])
  @@map("saved_resource")
}
