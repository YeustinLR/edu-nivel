{
  "name": "edu-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_INTEGRATION=1 vitest run src/server/auth/__tests__/registration-role.database.test.ts src/server/auth/__tests__/otp-rate-limit.database.test.ts src/server/content/__tests__/create-catalog-content.database.test.ts src/server/content/__tests__/create-catalog-resource.database.test.ts src/server/content/__tests__/update-content.database.test.ts src/server/payments/onvo/__tests__/reconcile.database.test.ts src/server/payments/onvo/__tests__/refunds.database.test.ts src/server/payments/onvo/__tests__/webhook-route.database.test.ts src/server/users/__tests__/user-invitation.database.test.ts",
    "test:watch": "vitest",
    "test:notifications:integration": "RUN_DATABASE_INTEGRATION=1 vitest run src/server/notifications/__tests__/notifications.database.test.ts",
    "check": "pnpm lint && pnpm exec tsc --noEmit && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "onvo:audit": "tsx scripts/onvo-gate1-audit.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@better-auth/prisma-adapter": "^1.6.22",
    "@blocknote/ariakit": "0.54.0",
    "@blocknote/code-block": "0.54.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/math-block": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.22",
    "dotenv": "^17.4.2",
    "katex": "0.16.22",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
